SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Cloudflare Turnstile secret (server only). The public site key is in site.config.ts.
TURNSTILE_SECRET_KEY=

# HubSpot CRM (server only, optional). Create a Private App in HubSpot: Settings > Integrations >
# Private Apps, with scopes crm.objects.contacts.read and crm.objects.contacts.write. Paste its access
# token here. When it is empty, leads are only emailed.
HUBSPOT_ACCESS_TOKEN=

# Blog admin (/admin) and MCP server (/api/mcp).
# MongoDB connection string, e.g. from MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=
# Random string, at least 32 characters, that signs admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
