# SMTP settings for the website forms (app/api/contact/route.ts).
# Copy this file to .env (or .env.local) and fill in real values there.
# NEVER put real credentials in this file: it is committed to git.

# Gmail / Google Workspace: smtp.gmail.com, port 587, and an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (default), 465 = SSL
SMTP_PORT=587
# Optional: force TLS mode ("true" for port 465). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password

# Sender shown in the inbox. With Gmail this must be SMTP_USER or a verified "Send mail as" alias.
MAIL_FROM="Konsilience Website <you@yourdomain.com>"
# Where submissions go (defaults to sales@konsilience.tech)
MAIL_TO=sales@konsilience.tech
