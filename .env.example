# SMTP settings for the website forms (app/api/contact/route.ts).
# Copy this file to .env.local and fill in your credentials. Never commit .env.local.

SMTP_HOST=smtp.example.com
# 587 = STARTTLS (default), 465 = SSL
SMTP_PORT=587
# Optional: force TLS mode ("true" for port 465). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=you@konsilience.tech
SMTP_PASS=your-smtp-password-or-app-password

# Optional: sender shown in the inbox (must be allowed by your SMTP provider)
MAIL_FROM="Konsilience Website <no-reply@konsilience.tech>"
# Optional: where submissions go (defaults to sales@konsilience.tech)
MAIL_TO=sales@konsilience.tech
