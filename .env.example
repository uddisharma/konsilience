SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Cloudflare Turnstile secret (server only). The public site key is in site.config.ts.
TURNSTILE_SECRET_KEY=

# HubSpot CRM (server only, optional). Create a Private App in HubSpot: Settings > Integrations >
# Private Apps, with scopes crm.objects.contacts.read and crm.objects.contacts.write. Paste its access
# token here. When it is empty, leads are only emailed.
HUBSPOT_ACCESS_TOKEN=

# Blog admin (/admin) and MCP server (/api/mcp).
# MongoDB connection string, e.g. from MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=
# Random string, at least 32 characters, that signs admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

# Cross-posting from the admin Publish menu (server only). Leave a platform empty to hide it.
# dev.to: Settings > Extensions > DEV Community API Keys.
DEVTO_API_KEY=
# Hashnode: hashnode.com/settings/developer (personal access token) and your publication's ID.
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=
# Bluesky: your handle and an app password from bsky.app/settings/app-passwords (not your login password).
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Tumblr: consumer key/secret from tumblr.com/oauth/apps, and the OAuth token pair for your account.
# TUMBLR_BLOG is the blog's host name, e.g. konsilience.tumblr.com.
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_TOKEN_SECRET=
TUMBLR_BLOG=
